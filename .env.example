# ============================================================
# ENVIRONMENT VARIABLES — copy this file to .env and fill in
# ============================================================

# MongoDB connection string
# Local:   mongodb://localhost:27017/accounting_club
# Atlas:   mongodb+srv://username:password@cluster.mongodb.net/accounting_club
MONGODB_URI=mongodb://localhost:27017/accounting_club

# Session secret — use a long, random string (32+ chars)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_very_long_random_secret_string_in_production

# Environment: development | production
NODE_ENV=development

# Server port
PORT=5000

# Admin seed credentials (used by utils/seed.js — change before running)
SEED_ADMIN_EMAIL=admin@ksu-accounting.edu.sa
SEED_ADMIN_PASSWORD=Admin@SecurePass123!

# CORS allowed origin (your frontend URL)
CORS_ORIGIN=http://localhost:3000
